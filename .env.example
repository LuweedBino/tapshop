# Postgres connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://tapshop:tapshop@localhost:5432/tapshop"
# Random string of 32+ characters used to sign login sessions: openssl rand -base64 48
AUTH_SECRET=""
# Public URL of the app, used in Stripe redirects and emailed download links
APP_URL="http://localhost:3000"

# Stripe (platform account with Connect enabled)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the webhook endpoint that listens to events on connected accounts
STRIPE_WEBHOOK_SECRET="whsec_..."
# Local testing only: let stores sell before connecting Stripe (money lands in the platform account)
ALLOW_PLATFORM_CHARGES="false"

# Email delivery via Resend. Without a key, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="TapShop <hello@yourdomain.com>"

# File storage: S3 or any S3-compatible store (Cloudflare R2, Backblaze B2...).
# Without S3_BUCKET, uploads are written to ./storage (local development only).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
