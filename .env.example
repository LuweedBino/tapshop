# Postgres connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://tapshop:tapshop@localhost:5432/tapshop"
# Random string of 32+ characters used to sign login sessions: openssl rand -base64 48
AUTH_SECRET=""
# Public URL of the app, used in Stripe redirects and emailed download links.
# On Vercel it defaults to the production domain.
APP_URL="http://localhost:3000"

# Comma-separated login emails that can open Dashboard → Admin (all creators and their sales)
ADMIN_EMAILS=""

# Stripe (platform account with Connect enabled)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the webhook endpoint that listens to events on connected accounts.
# Comma-separate several secrets if you register more than one endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Local testing only: let stores sell before connecting Stripe (money lands in the platform account)
ALLOW_PLATFORM_CHARGES="false"

# Email delivery via Resend. Without a key, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="TapShop <hello@yourdomain.com>"

# File storage, first match wins:
# 1. S3 or any S3-compatible store (Cloudflare R2, Backblaze B2...) when S3_BUCKET is set
# 2. A private Vercel Blob store when BLOB_READ_WRITE_TOKEN is set (Vercel adds it for you)
# 3. ./storage on local disk (development only)
BLOB_READ_WRITE_TOKEN=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
