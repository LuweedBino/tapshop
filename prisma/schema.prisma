generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DIGITAL
  LEAD_MAGNET
  LINK
  AFFILIATE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Creator {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  handle          String         @unique
  displayName     String
  bio             String         @default("")
  avatarKey       String?
  // Profile photo edits (zoom, focus point, filter, shape...); see src/lib/avatar.ts.
  avatarStyle     Json           @default("{}")
  accentColor     String         @default("#7c3aed")
  bannerKey       String?
  // Storefront design choices; valid values live in src/lib/design.ts.
  theme           String         @default("soft")
  font            String         @default("modern")
  buttonStyle     String         @default("rounded")
  layout          String         @default("card")
  socialLinks     Json           @default("{}")
  socialStyle     String         @default("text")
  // Social icon shape, colors and animations; see src/lib/iconStyle.ts.
  socialIconStyle Json           @default("{}")
  bannerStyle     Json           @default("{}")
  stripeAccountId String?        @unique
  stripeReady     Boolean        @default(false)
  // Set by an admin: the store goes offline and can't take new sales until it's cleared.
  pausedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  products        Product[]
  pages           Page[]
  mediaKit        MediaKit?
  inquiries       BrandInquiry[]
  vaultItems      VaultItem[]
  vaultFolders    VaultFolder[]
  orders          Order[]
  leads           Lead[]
  discountCodes   DiscountCode[]
}

// A creator's portfolio for brands at /<handle>/media-kit. Stats, audience, past
// partnerships, rates and photos live in `data` (see lib/mediaKit.ts).
model MediaKit {
  id        String   @id @default(cuid())
  creatorId String   @unique
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  published Boolean  @default(false)
  headline  String   @default("")
  about     String   @default("")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// A message a brand sent from a media kit's "Work with me" form.
model BrandInquiry {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String   @default("")
  budget    String   @default("")
  message   String
  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
}

// An extra storefront at /<handle>/<slug> with its own products. Products with no page are on the main store.
model Page {
  id          String    @id @default(cuid())
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String    @default("")
  createdAt   DateTime  @default(now())
  products    Product[]

  @@unique([creatorId, slug])
}

model Product {
  id            String      @id @default(cuid())
  creatorId     String
  creator       Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type          ProductType @default(DIGITAL)
  // Deleting a page moves its products back to the main store.
  pageId        String?
  page          Page?       @relation(fields: [pageId], references: [id], onDelete: SetNull)
  title         String
  subtitle      String      @default("")
  description   String      @default("")
  priceCents    Int         @default(0)
  currency      String      @default("usd")
  coverKey      String?
  fileKey       String?
  fileName      String?
  url           String?
  ctaLabel      String      @default("")
  // Digital products and links can also add visitors' emails to Leads. Lead magnets always do.
  collectEmails Boolean     @default(false)
  // Affiliate pages: video, extra images, extra buttons and a discount code (see lib/affiliate.ts).
  extras        Json        @default("{}")
  // Times visitors followed an affiliate page's links.
  clicks        Int         @default(0)
  published     Boolean     @default(true)
  // Archived products disappear from the store and dashboard but keep past buyers' downloads working.
  archived      Boolean     @default(false)
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]
  leads         Lead[]
  discountCodes DiscountCode[]

  @@index([creatorId, position])
}

// A code buyers type at checkout. See lib/discounts.ts.
model DiscountCode {
  id        String       @id @default(cuid())
  creatorId String
  creator   Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Stored in capitals, so buyers can type it either way.
  code      String
  type      DiscountType
  // Percent off (1-100) for PERCENT, cents off for FIXED.
  value     Int
  // null = every product in the store. Cascade, so a code for one product can't turn into a store-wide one.
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  // null = no limit. Uses are counted from orders, so markPaid doesn't need to know about codes.
  maxUses   Int?
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  orders    Order[]

  @@unique([creatorId, code])
}

model Order {
  id              String      @id @default(cuid())
  creatorId       String
  creator         Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerEmail      String
  buyerName       String      @default("")
  // What the buyer pays, after any discount.
  amountCents     Int
  currency        String
  // Deleting a code keeps its orders; discountCode keeps the text for the Orders page.
  discountId      String?
  discount        DiscountCode? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode    String      @default("")
  discountCents   Int         @default(0)
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  downloadToken   String      @unique
  downloadCount   Int         @default(0)
  emailSentAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([creatorId, createdAt])
  @@index([discountId])
}

model Lead {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email         String
  name          String   @default("")
  downloadToken String   @unique
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([productId, email])
  @@index([creatorId, createdAt])
}

// A file in a creator's Media Vault: uploads plus designs, videos and project files saved
// from Studio. The file itself is private storage at `key`; only its owner can open it.
model VaultItem {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  key         String   @unique
  name        String
  contentType String   @default("application/octet-stream")
  size        Int      @default(0)
  // video | image | audio | document | project | other (see lib/vault.ts)
  kind        String   @default("other")
  // upload | design | video
  source      String   @default("upload")
  // null = not in a folder. Deleting a folder keeps its files (they move back out).
  folderId    String?
  folder      VaultFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([folderId])
}

model VaultFolder {
  id        String      @id @default(cuid())
  creatorId String
  creator   Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name      String
  items     VaultItem[]
  createdAt DateTime    @default(now())

  @@index([creatorId])
}
