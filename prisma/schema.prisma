generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DIGITAL
  LEAD_MAGNET
  LINK
  AFFILIATE
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Creator {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  handle          String    @unique
  displayName     String
  bio             String    @default("")
  avatarKey       String?
  // Profile photo edits (zoom, focus point, filter, shape...); see src/lib/avatar.ts.
  avatarStyle     Json      @default("{}")
  accentColor     String    @default("#7c3aed")
  bannerKey       String?
  // Storefront design choices; valid values live in src/lib/design.ts.
  theme           String    @default("soft")
  font            String    @default("modern")
  buttonStyle     String    @default("rounded")
  layout          String    @default("card")
  socialLinks     Json      @default("{}")
  socialStyle     String    @default("text")
  // Social icon shape, colors and animations; see src/lib/iconStyle.ts.
  socialIconStyle Json      @default("{}")
  bannerStyle     Json      @default("{}")
  stripeAccountId String?   @unique
  stripeReady     Boolean   @default(false)
  // Set by an admin: the store goes offline and can't take new sales until it's cleared.
  pausedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  pages           Page[]
  orders          Order[]
  leads           Lead[]
}

// An extra storefront at /<handle>/<slug> with its own products. Products with no page are on the main store.
model Page {
  id          String    @id @default(cuid())
  creatorId   String
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String    @default("")
  createdAt   DateTime  @default(now())
  products    Product[]

  @@unique([creatorId, slug])
}

model Product {
  id            String      @id @default(cuid())
  creatorId     String
  creator       Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type          ProductType @default(DIGITAL)
  // Deleting a page moves its products back to the main store.
  pageId        String?
  page          Page?       @relation(fields: [pageId], references: [id], onDelete: SetNull)
  title         String
  subtitle      String      @default("")
  description   String      @default("")
  priceCents    Int         @default(0)
  currency      String      @default("usd")
  coverKey      String?
  fileKey       String?
  fileName      String?
  url           String?
  ctaLabel      String      @default("")
  // Digital products and links can also add visitors' emails to Leads. Lead magnets always do.
  collectEmails Boolean     @default(false)
  // Affiliate pages: video, extra images, extra buttons and a discount code (see lib/affiliate.ts).
  extras        Json        @default("{}")
  // Times visitors followed an affiliate page's links.
  clicks        Int         @default(0)
  published     Boolean     @default(true)
  // Archived products disappear from the store and dashboard but keep past buyers' downloads working.
  archived      Boolean     @default(false)
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]
  leads         Lead[]

  @@index([creatorId, position])
}

model Order {
  id              String      @id @default(cuid())
  creatorId       String
  creator         Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerEmail      String
  buyerName       String      @default("")
  amountCents     Int
  currency        String
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  downloadToken   String      @unique
  downloadCount   Int         @default(0)
  emailSentAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([creatorId, createdAt])
}

model Lead {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email         String
  name          String   @default("")
  downloadToken String   @unique
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([productId, email])
  @@index([creatorId, createdAt])
}
